# Mira has no code server. n8n stores these as credentials, not environment
# variables. This file lists every value you must enter.
# Never commit the real values or a real .env file.

# OpenAI: used by all AI nodes (gpt-4o-mini)
# n8n: Credentials, OpenAI API. Get the key at platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Langfuse (US cloud): used by the Trace node
# n8n: Credentials, Basic Auth, named "Langfuse"
# Public key = username, secret key = password
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key

# Langfuse OTLP endpoint. Use this one: the legacy /api/public/ingestion
# endpoint stops accepting traces on 2026-11-16.
LANGFUSE_OTLP_ENDPOINT=https://us.cloud.langfuse.com/api/public/otel/v1/traces

# Config node values (n8n: Config node)
# as_of_date is "today" for the demo data
AS_OF_DATE=2026-04-22
# Week 1 start date (assumed, because the timeline uses weeks)
PROJECT_START=2026-04-06
CURRENT_SPRINT=Sprint 3

# Raw GitHub URL used by the four Load nodes
DATA_BASE_URL=https://raw.githubusercontent.com/satcool22/Mira-AI-Powered-Project-Intelligence-Assistant/main/data
